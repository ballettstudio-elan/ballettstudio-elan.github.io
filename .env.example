# =====================================================================
# Пример файла окружения. НАСТОЯЩИЕ значения пишите в файл ".env"
# (скопируйте этот файл и переименуйте копию в ".env").
# Файл ".env" НЕ попадает в git (см. .gitignore).
#
# Где взять значения: Supabase → ваш проект → Project Settings → API
#   (или кнопка "Connect" вверху панели).
#
# ВАЖНО: сюда вписываются ТОЛЬКО публичные значения:
#   - Project URL
#   - anon / publishable key (он публичный по задумке Supabase, защиту дают RLS-правила)
# НИКОГДА не вписывайте сюда service_role / secret key — он даёт полный доступ к базе
# и попал бы в код сайта, который видит каждый посетитель.
# =====================================================================

PUBLIC_SUPABASE_URL=https://IHR-PROJEKT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=hier-den-anon-oder-publishable-key-einfuegen
