---
// Шапка сайта с меню. Пункты меню – в src/data/studio.js (navigation).
import { navigation, studio } from '../data/studio.js';

const path = Astro.url.pathname.replace(/\/?$/, '/');
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label={`${studio.name} – Startseite`}>
      <span class="brand-mark">{studio.kurzname}</span>
      <span class="brand-sub">Ballettstudio</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label="Menü öffnen">
      <span></span>
    </button>

    <div class="nav-menu" id="nav-menu">
      <nav aria-label="Hauptnavigation">
        <ul class="nav-links">
          {navigation.map((item) => (
            <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="nav-cta">
        <a class="btn btn-small" href="/probestunde/">Probestunde anfragen</a>
      </div>
    </div>
  </div>
</header>
