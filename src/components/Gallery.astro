---
// Галерея + окно увеличения фото.
// Список фото – в src/data/galerie.js. Этот файл менять не нужно.
// limit – показать только первые N фото (используется на главной странице).
import { galerie, galerieOrdner } from '../data/galerie.js';
const { limit, compact = false } = Astro.props;
const fotos = limit ? galerie.slice(0, limit) : galerie;
---
<div class:list={['gallery', { compact }]} data-gallery>
  {fotos.map((foto, i) => (
    <button class="gallery-item reveal" type="button" data-index={i} aria-label={`Bild vergrößern: ${foto.alt}`}>
      <img src={galerieOrdner + foto.datei} alt={foto.alt} loading="lazy" decoding="async" />
    </button>
  ))}
</div>

<div class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Bildansicht" data-lightbox>
  <span class="lb-counter" aria-live="polite"></span>
  <button class="lb-close" type="button" aria-label="Schließen">×</button>
  <button class="lb-prev" type="button" aria-label="Vorheriges Bild">‹</button>
  <figure>
    <img src="" alt="" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-next" type="button" aria-label="Nächstes Bild">›</button>
</div>

<script>
  const grid = document.querySelector('[data-gallery]');
  const box = document.querySelector('[data-lightbox]');
  if (grid && box) {
    const items = [...grid.querySelectorAll('.gallery-item img')];
    const img = box.querySelector('figure img');
    const caption = box.querySelector('figcaption');
    const counter = box.querySelector('.lb-counter');
    const btnClose = box.querySelector('.lb-close');
    const btnPrev = box.querySelector('.lb-prev');
    const btnNext = box.querySelector('.lb-next');
    let current = 0;
    let lastFocus = null;

    const show = (i) => {
      current = (i + items.length) % items.length;
      img.src = items[current].src;
      img.alt = items[current].alt;
      caption.textContent = items[current].alt;
      counter.textContent = `${current + 1} / ${items.length}`;
    };
    const open = (i) => {
      lastFocus = document.activeElement;
      show(i);
      btnPrev.hidden = btnNext.hidden = items.length < 2;
      box.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => box.classList.add('is-open'));
      btnClose.focus();
    };
    const close = () => {
      box.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(() => { box.hidden = true; img.src = ''; }, 250);
      lastFocus?.focus();
    };

    grid.addEventListener('click', (e) => {
      const btn = e.target.closest('.gallery-item');
      if (btn) open(Number(btn.dataset.index));
    });
    btnClose.addEventListener('click', close);
    btnPrev.addEventListener('click', () => show(current - 1));
    btnNext.addEventListener('click', () => show(current + 1));
    box.addEventListener('click', (e) => { if (e.target === box) close(); });
    document.addEventListener('keydown', (e) => {
      if (box.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'Tab') {
        // фокус остаётся внутри окна
        const f = [...box.querySelectorAll('button:not([hidden])')];
        const idx = f.indexOf(document.activeElement);
        e.preventDefault();
        f[(idx + (e.shiftKey ? -1 : 1) + f.length) % f.length].focus();
      }
    });
    let startX = null;
    box.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50 && items.length > 1) show(dx < 0 ? current + 1 : current - 1);
      startX = null;
    }, { passive: true });
  }
</script>
